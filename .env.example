APP_NAME="Salon Management System"
# Development defaults. FOR PRODUCTION set APP_ENV=production and APP_DEBUG=false, use an https:// APP_URL and SESSION_SECURE_COOKIE=true.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Salon timezone. Can be changed in Settings > General only until appointments or invoices exist.
APP_TIMEZONE=Africa/Mogadishu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salon_mana
DB_USERNAME=salon_app
DB_PASSWORD=
# Isolation level applied to every MySQL connection. Keep READ COMMITTED: booking, stock and numbering code relies on it (see README).
DB_ISOLATION_LEVEL="READ COMMITTED"
# For XAMPP defaults you may use root with an empty password locally ONLY. Use a least-privilege user in production.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set SESSION_SECURE_COOKIE=true when serving over HTTPS (required in production)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log only writes emails to storage/logs. Use smtp (and fill in the settings below) to really send them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salon defaults (configurable)
SALON_NAME="Salon Management System"
SALON_CURRENCY=USD
SALON_CURRENCY_SYMBOL='$'
SALON_DATE_FORMAT=Y-m-d
SALON_TIME_FORMAT=H:i

# Text messages. Only the "log" driver ships with the application: messages are written to the log and shown as
# "Logged, not delivered". A real gateway needs a driver class bound to App\Contracts\SmsGateway (see README).
SMS_DRIVER=log

# Backups (php artisan salon:backup). Binary paths are only needed when the tools are not on PATH.
# Windows/XAMPP example: MYSQLDUMP_PATH="C:\xampp\mysql\bin\mysqldump.exe"  MYSQL_CLIENT_PATH="C:\xampp\mysql\bin\mysql.exe"
# BACKUP_DIRECTORY=
# BACKUP_KEEP=14
# MYSQLDUMP_PATH=mysqldump
# MYSQL_CLIENT_PATH=mysql

# Comma separated proxy IPs, or * , when behind a load balancer / reverse proxy
# TRUSTED_PROXIES=
